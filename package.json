{
  "name": "mpp-validator",
  "version": "0.1.0",
  "private": true,
  "description": "Structural validator for Meaningful Participation Protocol objects",
  "type": "module",
  "license": "Apache-2.0",
  "bin": { "mpp-validate": "validator/validate.mjs" },
  "scripts": {
    "validate": "node validator/validate.mjs examples",
    "validate:invalid": "node validator/validate.mjs --expect-invalid examples/invalid",
    "test": "npm run validate && npm run validate:invalid"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  }
}
